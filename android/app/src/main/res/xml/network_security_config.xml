<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Tailscale is private WireGuard; the API is HTTP on the tailnet only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
